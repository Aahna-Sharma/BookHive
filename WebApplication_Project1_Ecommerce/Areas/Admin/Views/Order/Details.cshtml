@model WebApplication_Project1_Ecommerce.Models.OrderHeader
@using WebApplication_Project1_Ecommerce.Models
@using WebApplication_Project1_Ecommerce.Utility

@{
    ViewData["Title"] = $"Order #{Model.Id}";
    var details = ViewBag.OrderDetails as IEnumerable<OrderDetail>;
}

<section class="cinema-panel admin-orders">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Order #@Model.Id</p>
            <h1>@Model.Name</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-light">Back</a>
    </div>

    <div class="order-detail-grid">
        <div class="order-detail-block">
            <h2>Customer</h2>
            <p>@Model.Name</p>
            <p>@Model.PhoneNumber</p>
            <p>@Model.ApplicationUser?.Email</p>
            <p>@Model.StreetAddress, @Model.City, @Model.State - @Model.PostalCode</p>
        </div>
        <div class="order-detail-block">
            <h2>Status</h2>
            <p><span class="status-pill">@Model.OrderStatus</span></p>
            <p><span class="status-pill payment">@Model.PaymentStatus</span></p>
            <p>Total: <strong>$@Model.OrderTotal.ToString("0.00")</strong></p>
            <p>Ordered: @Model.OrderDate.ToString("dd MMM yyyy hh:mm tt")</p>
        </div>
    </div>

    <div class="table-responsive mt-4">
        <table class="table table-dark table-hover align-middle order-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in details)
                {
                    <tr>
                        <td>@item.Product.Title</td>
                        <td>@item.Count</td>
                        <td>$@item.Price.ToString("0.00")</td>
                        <td>$@((item.Price * item.Count).ToString("0.00"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.OrderStatus != SD.OrderStatusShipped && Model.OrderStatus != SD.OrderStatusCancelled)
    {
        <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="mt-3">
            <button type="submit" class="btn btn-danger">Cancel Order</button>
        </form>
    }
</section>
