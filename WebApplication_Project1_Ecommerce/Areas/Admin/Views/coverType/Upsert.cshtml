@model WebApplication_Project1_Ecommerce.Models.coverType

@{
    var title = Model.Id != 0 ? "Edit Cover Type" : "New Cover Type";
}

<section class="admin-page-shell admin-form-shell">
    <div class="admin-page-header">
        <div>
            <p class="eyebrow">Content Management</p>
            <h1>@title</h1>
            <p>Organize book formats and cover styles for the storefront catalogue.</p>
        </div>
    </div>

    <form method="post" class="admin-form-card">
        @if (Model.Id != 0)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="admin-form-grid">
            <div class="admin-field admin-field-wide">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="admin-form-actions">
            @if (Model.Id != 0)
            {
                <partial name="_EditAndBackToList" />
            }
            else
            {
                <partial name="_CreateAndBackToList" />
            }
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
