<div class="row p-2 m-2">
    <div class="col-9">
        <h2 class="text-primary">User List</h2>
    </div>
    <div class="col-3">
        <a asp-page="/Account/Register" asp-area="Identity" class="btn btn-info form-control">
            <i class="fas fa-plus"></i>&nbsp;Add New User
        </a>
    </div>
    <div class="container rounded border pt-2">
        <table id="tbldata" class="table table-bordered table-striped table-active">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Company</th>
                    <th>Role</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/user.js"></script>
}