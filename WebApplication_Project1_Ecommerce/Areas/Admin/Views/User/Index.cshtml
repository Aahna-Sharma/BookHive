<section class="admin-page-shell">
    <div class="admin-page-header">
        <div>
            <p class="eyebrow">Member Management</p>
            <h1>Users</h1>
            <p>Review customers, roles, company links, and account status.</p>
        </div>
        <a asp-page="/Account/Register" asp-area="Identity" class="btn btn-primary">
            <i class="fas fa-plus"></i>&nbsp;Add User
        </a>
    </div>

    <div class="admin-table-card">
        <table id="tbldata" class="table table-hover admin-data-table w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Company</th>
                    <th>Role</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/user.js"></script>
}
