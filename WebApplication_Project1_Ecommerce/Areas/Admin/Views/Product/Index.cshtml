<section class="admin-page-shell">
    <div class="admin-page-header">
        <div>
            <p class="eyebrow">Content Management</p>
            <h1>Products</h1>
            <p>Manage the catalogue, pricing, covers, and product visibility.</p>
        </div>
        <a asp-action="Upsert" class="btn btn-primary">
            <i class="fas fa-plus"></i>&nbsp;Add Product
        </a>
    </div>

    <div class="admin-table-card">
        <table id="tbldata" class="table table-hover admin-data-table w-100">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Author</th>
                    <th>ISBN</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/Product.js"></script>
}
