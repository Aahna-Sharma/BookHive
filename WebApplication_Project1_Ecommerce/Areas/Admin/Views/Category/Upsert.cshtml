@model WebApplication_Project1_Ecommerce.Models.Category

@{
    var title = Model.Id != 0 ? "Edit Category" : "New Category";
    var saveUpdate = Model.Id != 0 ? "Update" : "Save";
}

<form method="post">
    @if (Model.Id != 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="col-10 border-bottom">
        <h2 class="text-center text-primary">@title</h2>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-8">
        <div class="form-group row p-2 m-2">
            <div class="col-4">
                <label asp-for="Name"></label>
            </div>

            <div class="col-8">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
            
        <div class="form-group row p-2 m-2">
            <div class="col-8 offset-4">
                @if (Model.Id != 0)
                {
                    <partial name="_EditAndBackToList" />
                }
                else
                {
                    <partial name="_CreateAndBackToList" />
                }
            </div>
        </div>

    </form>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }