<section class="admin-page-shell">
    <div class="admin-page-header">
        <div>
            <p class="eyebrow">Content Management</p>
            <h1>Categories</h1>
            <p>Organize books into browsing sections customers can scan quickly.</p>
        </div>
        <a asp-action="Upsert" class="btn btn-primary">
            <i class="fas fa-plus"></i>&nbsp;Add Category
        </a>
    </div>

    <div class="admin-table-card">
        <table id="tbldata" class="table table-hover admin-data-table w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/Category.js"></script>
}
