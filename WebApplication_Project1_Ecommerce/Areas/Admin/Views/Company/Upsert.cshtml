@model WebApplication_Project1_Ecommerce.Models.Company

@{
    var title = Model.Id != 0 ? "Edit Company" : "New Company";
}

<section class="admin-page-shell admin-form-shell">
    <div class="admin-page-header">
        <div>
            <p class="eyebrow">Member Management</p>
            <h1 style =" color: #ffffff;
                letter-spacing: -0.5px;
                /* strong layered text shadow for contrast */
                text-shadow: 0 2px 4px rgba(0, 0, 0, 0.15), 0 6px 12px rgba(0, 0, 0, 0.12), 0 12px 24px rgba(0, 0, 0, 0.10);
                /* subtle stroke effect */
                -webkit-text-stroke: 0.4px rgba(19, 34, 56, 0.25);">
                @title</h1>
            <p>Maintain company billing, contact, and authorization details.</p>
        </div>
    </div>

    <form method="post" class="admin-form-card">
        @if (Model.Id != 0)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="admin-form-grid">
            <div class="admin-field admin-field-wide">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="StreetAddress"></label>
                <input asp-for="StreetAddress" class="form-control" />
                <span asp-validation-for="StreetAddress" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="City"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="State"></label>
                <input asp-for="State" class="form-control" />
                <span asp-validation-for="State" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="PostalCode"></label>
                <input asp-for="PostalCode" class="form-control" />
                <span asp-validation-for="PostalCode" class="text-danger"></span>
            </div>
            <label class="admin-check-field">
                <input asp-for="IsAuthorizedCompany" />
                <span>Authorized company account</span>
            </label>
        </div>

        <div class="admin-form-actions">
            @if (Model.Id != 0)
            {
                <partial name="_EditAndBackToList" />
            }
            else
            {
                <partial name="_CreateAndBackToList" />
            }
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
