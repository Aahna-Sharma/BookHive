<section class="admin-page-shell">
    <div class="admin-page-header">
        <div>
            <p class="eyebrow">Member Management</p>
            <h1>Companies</h1>
            <p>Manage business customers and their authorization status.</p>
        </div>
        <a asp-action="Upsert" class="btn btn-primary">
            <i class="fas fa-plus"></i>&nbsp;Add Company
        </a>
    </div>

    <div class="admin-table-card">
        <table id="tbldata" class="table table-hover admin-data-table w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Phone Number</th>
                    <th>Is Authorized</th>
                    <th>Action</th>
                </tr>
            </thead>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/Company.js"></script>
}
