<div class="row p-2 m-2">
    <div class="col-9">
        <h2 class="text-primary">Comapny</h2>
    </div>
    <div class="col-3">
        <a asp-action="Upsert" class="btn btn-info form-control">
            <i class="fas fa-plus"></i>&nbsp;Add New Company
        </a>
    </div>
    <div class="container rounded border pt-2">
        <table id="tbldata" class="table table-bordered table-striped table-active">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Phone Number</th>
                    <th>Is Authorized</th>
                    <th>Action</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts{
    <script src="~/js/Company.js"></script>
}