<style>
    .addbtn {
        border: 1px solid white;
        align-content: center;
        color: white;
        background-color: #0f4c5c;
        text-decoration: none;
        padding: 10px 30px;
    }

        .addbtn:hover {
            border: 1px solid black;
            align-content: center;
            color: black;
            background-color: darkcyan;
        }
</style>
<section class="admin-page-shell">
    <div class="admin-page-header">
        <div>
            <p class="eyebrow">Member Management</p>
            <h1 style =" color: #ffffff;
                letter-spacing: -0.5px;
                /* strong layered text shadow for contrast */
                text-shadow: 0 2px 4px rgba(0, 0, 0, 0.15), 0 6px 12px rgba(0, 0, 0, 0.12), 0 12px 24px rgba(0, 0, 0, 0.10);
                /* subtle stroke effect */
                -webkit-text-stroke: 0.4px rgba(19, 34, 56, 0.25);">
                Companies</h1>
            <p>Manage business customers and their authorization status.</p>
        </div>
        <a asp-action="Upsert" class="btn addbtn">
            <i class="fas fa-plus"></i>&nbsp;&nbsp;Add Company
        </a>
    </div>

    <div class="admin-table-card">
        <style>
                    .action-btn {
                        width: 40px !important;
                        height: 40px !important;
                        border-radius: 12px !important;
                        display: flex !important;
                        align-items: center !important;
                        justify-content: center !important;
                        padding: 0 !important;
                        border: none !important;
                        transition: all 0.25s ease !important;
                    }

                    /* spacing between buttons */
                    .d-flex.gap-2 {
                        gap: 12px !important;
                    }

                    /* icons smaller */
                    .action-btn i {
                        font-size: 13px !important;
                    }

                    /* hover */
                    .action-btn:hover {
                        transform: translateY(-2px) scale(1.04) !important;
                    }
                    /* EDIT */
                    .edit-btn {
                        background: linear-gradient(135deg, #0f766e, #115e59) !important;
                        color: white !important;
                        box-shadow: 0 8px 18px rgba(15, 118, 110, 0.18) !important;
                    }

                        .edit-btn:hover {
                            transform: translateY(-3px) scale(1.06) !important;
                            background: linear-gradient(135deg, #14b8a6, #0f766e) !important;
                            color: white !important;
                        }

                    /* DELETE */
                    .delete-btn {
                        background: linear-gradient(135deg, #dc2626, #b91c1c) !important;
                        color: white !important;
                        box-shadow: 0 8px 18px rgba(220, 38, 38, 0.18) !important;
                    }

                        .delete-btn:hover {
                            transform: translateY(-3px) scale(1.06) !important;
                            background: linear-gradient(135deg, #ef4444, #dc2626) !important;
                            color: white !important;
                        }

                    /* ICONS */
                    .action-btn i {
                        font-size: 15px !important;
                    }
        </style>
        <table id="tbldata" class="table table-hover admin-data-table w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Phone Number</th>
                    <th>Is Authorized</th>
                    <th>Action</th>
                </tr>
            </thead>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/Company.js"></script>
}
