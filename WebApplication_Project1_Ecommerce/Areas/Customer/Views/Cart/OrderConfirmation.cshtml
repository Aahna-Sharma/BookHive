@model int;

<section class="order-confirmation cinema-panel">
    <div class="confirmation-mark">
        <i class="fa-solid fa-check"></i>
    </div>
    <p class="eyebrow">Order confirmed</p>
    <h1>Your books are on the way.</h1>
    <p>Thank you for your order. Your invoice has been emailed with the full order details.</p>
    <div class="confirmation-number">Order #@Model</div>
    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
</section>
