@model WebApplication_Project1_Ecommerce.Models.ViewModels.ShoppingCartVM;

@{
    var fallbackImage = Url.Content("~" + ProductImageHelper.FallbackProductImageUrl);
}

<style>
    body {
        background: #f5f5f7;
    }

    .cart-page {
        padding: 20px 0;
    }

    .cart-title {
        font-size: 34px;
        font-weight: 700;
        color: #111;
    }

    .continue-btn {
        border-radius: 12px;
        padding: 12px 85px;
        font-weight: 500;
        border: 2px solid #0b554f !important;
        color: #0b554f !important;
        background: #ffffff;
        font-size: 16px;
        margin-right: 5px;
        transition: all 0.3s ease;
    }

        /* Proper Hover */
        .continue-btn:hover {
            background: #0b554f !important;
            color: #ffffff !important;
            border: 2px solid #0b554f !important;
            transform: translateY(-1px);
            box-shadow: rgba(15, 107, 100, 0.07) 0px 1px 2px, rgba(15, 107, 100, 0.07) 0px 2px 4px, rgba(15, 107, 100, 0.07) 0px 4px 8px, rgba(15, 107, 100, 0.07) 0px 8px 16px, rgba(15, 107, 100, 0.07) 0px 16px 32px, rgba(15, 107, 100, 0.07) 0px 32px 64px;
        }

        /* Prevent Bootstrap override on focus */
        .continue-btn:focus,
        .continue-btn:active {
            box-shadow: none !important;
            outline: none !important;
            background: #0b554f;
            color: #ffffff !important;
        }
    /* LEFT PANEL */

    .cart-container {
        background: #fff;
        border-radius: 22px;
        padding: 30px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.04);
    }

    .select-all-row {
        padding-bottom: 20px;
        
        margin-bottom: 10px;

        align-items: center;
        background: #ffffff;
        border: 0px solid #e5e9f0;
         border-radius: 8px;
        display: inline-flex;
        
        
    }
    .form-check-input {
        width: 15px;
        height: 15px;
        cursor: pointer;
        background-color: #111;
        border-color: #111;
    }

    #selectAll {
        width: 15px;
        height: 15px;
    }

    .form-check-input:checked {
        background-color: #111;
        border-color: #111;
    }


    .cart-row {
        padding: 28px 0;
        border-bottom: 1px solid #f2f2f2;
        cursor: pointer;
       
    }
    .cart-row:hover{
            box-shadow: rgba(0, 0, 0, 0.15) 1.95px 1.95px 2.6px;
    }

        .cart-row:last-child {
            border-bottom: none;
        }

    .product-img {
        width: 105px;
        height: 145px;
        object-fit: cover;
        border-radius: 14px;
        border: 1px solid #f1f1f1;
        background: #fafafa;
    }

    .book-title {
        font-size: 20px;
        font-weight: 600;
        color: #111;
        margin-bottom: 10px;
    }

    .book-desc {
        font-size: 14px;
        color: #6e6e73;
        line-height: 1.6;
        margin-bottom: 14px;
        max-width: 90%;
    }

    .price-line {
        font-size: 15px;
        color: #444;
    }

    .final-price {
        font-size: 20px;
        font-weight: 700;
        color: #111;
    }

    /* QTY */

    .qty-wrapper {
        display: flex;
        align-items: center;
        gap: 14px;
        justify-content: flex-end;
    }

    .qty-box {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fafafa;
        border-radius: 50px;
        padding: 6px 10px;
    }

    .qty-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: none;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: #111;
        transition: 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

        .qty-btn:hover {
            background: #111;
            color: white;
            text-decoration: none;
        }

    .qty-value {
        min-width: 25px;
        text-align: center;
        font-size: 18px;
        font-weight: 600;
    }

    .delete-btn {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        border: 1px solid #ffe3e3;
        background: #fff5f5;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: 0.2s;
    }

        .delete-btn:hover {
            background: #dc3545;
            color: white;
        }

    /* RIGHT PANEL */

    .summary-box {
        background: white;
        border-radius: 22px;
        padding: 30px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.04);
        position: sticky;
        top: 30px;
    }

    .summary-title {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 25px;
        color: #111;
    }

    .summary-total {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .summary-note {
        color: #6e6e73;
        font-size: 14px;
        margin-bottom: 30px;
        line-height: 1.7;
    }

    .checkout-btn {
        height: 56px;
        border-radius: 14px;
        font-size: 17px;
        font-weight: 600;
        background: #0b554f;
        border: none;
        color: white;
        width: 100%;
        transition: 0.2s;
    }

        .checkout-btn:hover {
            background: #fff;
            color: #0b554f;
            border: 2px solid #0b554f;
            transform:translateY(-2px);
            box-shadow: rgba(15, 107, 100, 0.07) 0px 1px 2px, rgba(15, 107, 100, 0.07) 0px 2px 4px, rgba(15, 107, 100, 0.07) 0px 4px 8px, rgba(15, 107, 100, 0.07) 0px 8px 16px, rgba(15, 107, 100, 0.07) 0px 16px 32px, rgba(15, 107, 100, 0.07) 0px 32px 64px;
          }

    @@media(max-width: 768px) {
        .product-img {
            width: 85px;
            height: 120px;
        }

        .qty-wrapper {
            justify-content: flex-start;
            margin-top: 20px;
        }

        .summary-box {
            position: static;
            margin-top: 20px;
        }

        .book-desc {
            max-width: 100%;
        }
    }
</style>

<form method="post" class="cart-page">
    <div class="container">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap ">
            <div class="cart-title">
                Shopping Cart
            </div>

            <a asp-action="Index"
               asp-controller="Home"
               class="btn continue-btn" >
                <i class="fa-solid fa-cart-shopping"></i>&nbsp;
                
                Continue Shopping
            </a>
        </div>

        <div class="row g-4">

            <!-- LEFT SIDE -->
            <div class="col-lg-8">

                <div class="cart-container">

                    <!-- Select All -->
                    <div class="select-all-row d-flex align-items-center mb-4">
                        <input type="checkbox"
                               id="selectAll"
                               class="form-check-input"
                               checked />

                        <label for="selectAll"
                               class="ms-2 fw-semibold mb-0">
                            <b>Select All Items</b>
                        </label>
                    </div>
                    <hr />
                    <!-- Products -->
                    @foreach (var list in Model.ListCart)
                    {
                        var imageUrl = ProductImageHelper.NormalizeProductImageUrl(list.Product.ImageUrl);

                        <div class="cart-row item-row">

                            <div class="row align-items-center">

                                <!-- Checkbox -->
                                <div class="col-lg-1 col-2 text-center">
                                    <input type="checkbox"
                                           name="selectedItems"
                                           value="@list.Id"
                                           class="item-checkbox form-check-input"
                                           data-price="@list.Price"
                                           data-count="@list.Count"
                                           checked />
                                </div>

                                <!-- Image -->
                                <div class="col-lg-2 col-3">
                                    <img src="@Url.Content("~" + imageUrl)"
                                         class="product-img"
                                         alt="@list.Product.Title"
                                         onerror="this.onerror=null;this.src='@fallbackImage';" />
                                </div>

                                <!-- Details -->
                                <div class="col-lg-5 col-7">
                                    <div class="book-title">
                                        @list.Product.Title
                                    </div>

                                    <div class="book-desc">
                                        @Html.Raw(@list.Product.Description)
                                    </div>

                                    <div class="price-line">
                                        $@list.Price.ToString("0.00") x @list.Count =
                                        <span class="final-price">
                                            $@((list.Price * list.Count).ToString("0.00"))
                                        </span>
                                    </div>
                                </div>

                                <!-- Qty -->
                                <div class="col-lg-4 col-12">
                                    <div class="qty-wrapper">

                                        <div class="qty-box">
                                            <a asp-action="Minus"
                                               asp-route-id="@list.Id"
                                               class="qty-btn stop-click">
                                                <i class="fas fa-minus"></i>
                                            </a>

                                            <div class="qty-value">
                                                @list.Count
                                            </div>

                                            <a asp-action="Plus"
                                               asp-route-id="@list.Id"
                                               class="qty-btn stop-click">
                                                <i class="fas fa-plus"></i>
                                            </a>
                                        </div>

                                        <a asp-action="Delete"
                                           asp-route-id="@list.Id"
                                           class="delete-btn stop-click">
                                            <i class="fas fa-trash"></i>
                                        </a>

                                    </div>
                                </div>

                            </div>

                        </div>
                    }

                </div>
            </div>

            <!-- RIGHT SIDE -->
            <div class="col-lg-4">

                <div class="summary-box">

                    <div class="summary-title">
                        Order Summary
                    </div>

                    <div class="d-flex justify-content-between summary-total">
                        <span>Total</span>
                        <span>
                            $<span id="txtOrderTotal">
                            @Model.OrderHeader.OrderTotal
                        </span>
                    </span>
                </div>

                <div class="summary-note">
                    Free shipping included<br />
                    Secure checkout available
                </div>

                @if (!Model.OrderHeader.ApplicationUser.EmailConfirmed)
                {
                    <div class="@ViewBag.EmailCSS mb-3">
                        @ViewBag.EmailMessage
                    </div>

                    <button type="submit"
                            asp-action="Index"
                            class="btn btn-warning w-100">
                        Resend Confirmation Email
                    </button>
                }
                else
                {
                    <button type="submit"
                            asp-action="Summary"
                            asp-controller="Cart"
                            formmethod="get"
                            data-require-selection="true"
                            class="checkout-btn">
                        <i class="fa-solid fa-truck-fast"></i>&nbsp;
                        Proceed to Checkout
                    </button>
                }

            </div>

        </div>

    </div>
</div>
</form>


@section Scripts{
    <script>
        function updateTotal() {
            let total = 0;

            $('.item-checkbox:checked').each(function () {
                let price = parseFloat($(this).data('price'));
                let count = parseInt($(this).data('count'));

                total += price * count;
            });

            $('#txtOrderTotal').text(total.toFixed(2));
        }

        $(document).ready(function () {

            // Select All checkbox
            $('#selectAll').change(function () {
                $('.item-checkbox').prop('checked', this.checked);
                updateTotal();
            });

            // Form submit validation
            $('form').submit(function () {
                var submitter = document.activeElement;
                var shouldValidateSelection =
                    $(submitter).data('require-selection') === true;

                if (shouldValidateSelection &&
                    $('.item-checkbox:checked').length === 0) {

                    alert("Please select at least one item");
                    return false;
                }
            });

            // Individual checkbox change
            $('.item-checkbox').change(function () {

                // If one unchecked → uncheck Select All
                if (!this.checked) {
                    $('#selectAll').prop('checked', false);
                }

                // If all checked → check Select All
                if ($('.item-checkbox:checked').length ===
                    $('.item-checkbox').length) {
                    $('#selectAll').prop('checked', true);
                }

                updateTotal();
            });

            // Whole cart row acts like checkbox
            $('.item-row').click(function (e) {

                // Prevent toggle when clicking buttons
                if ($(e.target).closest('.stop-click').length) {
                    return;
                }

                let checkbox = $(this).find('.item-checkbox');

                checkbox.prop('checked', !checkbox.prop('checked'));
                checkbox.trigger('change');
            });

            // Initial total
            updateTotal();
        });
    </script>
}
