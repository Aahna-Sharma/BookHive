@model IEnumerable<WebApplication_Project1_Ecommerce.Models.Product>

@{
    var products = Model?.ToList() ?? new List<WebApplication_Project1_Ecommerce.Models.Product>();
    var soldCounts = ViewBag.SoldCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var popularProductIds = ViewBag.PopularProductIds as HashSet<int> ?? new HashSet<int>();
    var featured = products.OrderByDescending(product => soldCounts.ContainsKey(product.Id) ? soldCounts[product.Id] : 0).FirstOrDefault()
        ?? products.FirstOrDefault();
    var fallbackImage = Url.Content("~" + ProductImageHelper.FallbackProductImageUrl);
}

<style>
   
    .home-hero {
        background: linear-gradient(-45deg, #f6c453, #0f9f6e, #23a6d5,#083c3a, #23d5ab);
        background-size: 400% 400%;
        animation: gradient 15s ease infinite;
        border-radius: 28px;
        padding: 60px;
        margin-bottom: 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 40px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
        transition: 0.35s ease;
    }

    @@keyframes gradient {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .home-hero:hover {
        transform: translateY(-4px);
    }

    .storefront-kicker {
        font-size: 14px;
        font-weight: 700;
        color: #0d6efd;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
    }

    /* LEFT TO RIGHT TEXT ANIMATION FOR HERO SECTION */

    .home-hero h1 {
        font-size: 52px;
        font-weight: 900;
        color: #ffffff;
        line-height: 1.2;
        margin-bottom: 18px;
        letter-spacing: -0.5px;
        /* strong layered text shadow for contrast */
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.15), 0 6px 12px rgba(0, 0, 0, 0.12), 0 12px 24px rgba(0, 0, 0, 0.10);
        /* subtle stroke effect */
        -webkit-text-stroke: 0.4px rgba(19, 34, 56, 0.25);
        /* animation */
        opacity: 0;
        transform: translateX(-60px);
        animation: slideRightHero 1s ease forwards;
    }


    .home-hero p {
        font-size: 17px;
        color: #5f6368;
        line-height: 1.8;
        max-width: 560px;
        /* animation */
        opacity: 0;
        transform: translateX(-60px);
        animation: slideRightHero 1s ease forwards;
        animation-delay: 0.3s;
    }

    @@keyframes slideRightHero {
        from {
            opacity: 0;
            transform: translateX(-60px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    /* Hero Button */
    .home-hero .btn-warning {
        background: #132238;
        border: none;
        color: #fff;
        padding: 14px 34px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 16px;
        transition: 0.3s;
    }

        .home-hero .btn-warning:hover {
            background: rgba(24, 32, 29, 0.23);
            border: 2px solid rgba(255, 255, 255, 0.96);
            
            color: #ffffff;
            
        }

    /* Featured Card */
    .featured-book-panel {
        background-color: rgba(255,255,255, 0.34);
        padding: 24px;
        border-radius: 24px;
        width: 400px;
        box-shadow: rgba(0, 0, 0, 0.09) 0px 2px 1px, rgba(0, 0, 0, 0.09) 0px 4px 2px, rgba(0, 0, 0, 0.09) 0px 8px 4px, rgba(0, 0, 0, 0.09) 0px 16px 8px, rgba(0, 0, 0, 0.09) 0px 32px 16px;
        transition: 0.3s;
        color: black;
    }

        .featured-book-panel:hover {
            transform: scale(1.02);
        }

    .featured-label {
        display: inline-block;
        
        color: #0d6efd;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 16px;
        box-shadow: rgb(0,0,0, 0.15) 3px 3px 6px 0px inset, rgba(0, 0, 0, 0.05) -3px -3px 6px 1px inset;
    }

    .featured-book-panel img {
        width: 100%;
        height: 290px;
        object-fit: cover;
        border-radius: 12px;

    }

    /* Filter Bar */
    .home-filter-bar {
        background: white;
        border-radius: 20px;
        
        margin-bottom: 35px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
    }

    .filter-field label {
        font-weight: 600;
        color: #222;
       padding:0px;
    }

    .form-control {
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        
        box-shadow: none !important;
    }

        .form-control:focus {
            border-color: #0d6efd;
        }

    /* Product Cards */
    .home-product-card {
        background: white;
        border: none;
        border-radius: 22px;
        padding: 18px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.04);
        transition: 0.35s ease;
        overflow: hidden;
    }

        .home-product-card:hover {
            transform: translateY(-8px);
            box-shadow: rgba(136, 165, 191, 0.48) 6px 2px 16px 0px, rgba(255, 255, 255, 0.8) -6px -2px 16px 0px;
        }
   
    /* FIX BOOK IMAGES INSIDE PRODUCT CARDS */

    .product-cover-wrap {
        background: #ffffff;
        border-radius: 20px;
       
        height: 340px; /* fixed taller container */
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    /* Better image fitting */
    .product-cover {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain; /* keeps full book visible */
        display: block;
        transition: transform 0.35s ease;
    }

    /* Smooth hover zoom */
    .home-product-card:hover .product-cover {
        transform: scale(1.06);
    }

    /* Make cards more balanced */
    .home-product-card {
        min-height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    /* Optional: improve image frame look */
    .product-cover-wrap::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 20px;
        pointer-events: none;
    }
    /* Product Title */
    .product-title {
        font-size: 18px;
        font-weight: 700;
        color: #111;
        margin-top: 16px;
        margin-bottom: 8px;
    }

    .product-author {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 14px;
    }

    /* Price */
    .product-price {
        color: #132238;
        font-size: 22px;
        font-weight: 800;
    }

    /* View Details Button */
    .home-product-card .btn-primary {
        background: #132238;
        border: none;
        border-radius: 14px;
        height: 50px;
        font-weight: 600;
        transition: 0.3s;
    }

        .home-product-card .btn-primary:hover {
            background: linear-gradient(-45deg, #0f9f6e, #23a6d5, #083c3a);
            
            animation: gradient 15s ease infinite;
           border: 1px solid black;
           
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
            transition: 0.35s ease;
        }

    @@keyframes gradient {
        0% {
            background-position: 0% 50%;
        }

        100% {
            background-position: 100% 50%;
        }

    }

    /* Popular Badge */
    .popular-badge {
        position: absolute;
        top: 18px;
        left: 18px;
        background: #ff6b35;
        color: white;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        z-index: 2;
    }

    /* Responsive */
    
    @@media (max-width: 991px) {
        .home-hero {
            flex-direction: column;
            padding: 35px;
        }

            .home-hero h1 {
                font-size: 38px;
            }

        .featured-book-panel {
            width: 100%;
        }
    }
</style>

<section class="home-hero homes">
    <div class="home-hero-content">
        <p class="storefront-kicker">BookHive collections</p>
        <h1>Discover books with a little more electricity.</h1>
        <p>Browse curated picks, compare prices, and jump into the stories readers are choosing right now.</p>
        <div class="home-hero-actions">
            <a href="#productContainer" class="btn btn-warning">Explore Books</a>
            <span>@products.Count book@(products.Count == 1 ? "" : "s") available</span>
        </div>
    </div>

    @if (featured != null)
    {
        var featuredImageUrl = ProductImageHelper.NormalizeProductImageUrl(featured.ImageUrl);

        <div class="featured-book-panel">
            <span class="featured-label">Featured pick</span>
            <img src="@Url.Content("~" + featuredImageUrl)" alt="@featured.Title" onerror="this.onerror=null;this.src='@fallbackImage';" />
            <div>
                <strong>@featured.Title</strong>
                <small>by @featured.Author</small>
            </div>
        </div>
    }
</section>

<section class="shop-filter-bar home-filter-bar">
    <div class="filter-field">
        <label for="searchInput">Search</label>
        <input type="text" id="searchInput" class="form-control" placeholder="Title or author" />
    </div>

    <div class="filter-field">
        <label for="sortSelect">Sort</label>
        <select id="sortSelect" class="form-control">
            <option value="">Featured</option>
            <option value="priceAsc">Price: Low to High</option>
            <option value="priceDesc">Price: High to Low</option>
            <option value="title">Title</option>
            <option value="author">Author</option>
            <option value="sold">Most Sold</option>
        </select>
    </div>

    <div class="filter-actions" aria-label="Price filters">
        <button type="button" class="btn btn-outline-primary price-filter active" data-max="">All</button>
        <button type="button" class="btn btn-outline-primary price-filter" data-max="10">Under $10</button>
        <button type="button" class="btn btn-outline-primary price-filter" data-max="20">Under $20</button>
        <button type="button" class="btn btn-outline-primary price-filter" data-max="50">Under $50</button>
    </div>
</section>

<div id="productContainer" class="row product-grid">
    @foreach (var product in products)
    {
        var sold = soldCounts.ContainsKey(product.Id) ? soldCounts[product.Id] : 0;
        var imageUrl = ProductImageHelper.NormalizeProductImageUrl(product.ImageUrl);

        <div class="col-xl-3 col-lg-4 col-md-6 product-item"
             data-title="@product.Title.ToLower()"
             data-author="@product.Author.ToLower()"
             data-price="@product.Price100"
             data-sold="@sold">
            <article class="product-card home-product-card h-100">
                @if (popularProductIds.Contains(product.Id))
                {
                    <span class="popular-badge"><i class="fa-solid fa-fire"></i> Popular</span>
                }

                <div class="product-cover-wrap">
                    <img src="@Url.Content("~" + imageUrl)" class="product-cover" alt="@product.Title" onerror="this.onerror=null;this.src='@fallbackImage';" />
                </div>

                <div class="product-card-body">
                    <p class="product-title">@product.Title</p>
                    <p class="product-author">by @product.Author</p>
                </div>

                <div class="product-pricing">
                    <span class="product-list-price"><strike>$@product.ListPrice.ToString("0.00")</strike></span>
                    <strong class="product-price">$@product.Price100.ToString("0.00")</strong>
                </div>

                <div class="product-meta-line">
                    <span><i class="fa-solid fa-bag-shopping"></i> @sold sold</span>
                    <span>ISBN @product.ISBN</span>
                </div>

                <a asp-action="Details"
                   asp-route-id="@product.Id"
                   class="btn btn-primary form-control mt-auto text-white align-content-center">
                    View Details
                </a>
            </article>
        </div>
    }
</div>

<div id="emptyState" class="home-empty-state d-none">
    <h3>No books matched your filters</h3>
    <p>Try a different search term or clear the price filter.</p>
</div>

@section Scripts {
    <script>
        $(function () {
            let maxPrice = Infinity;

            function applyFilters() {
                const search = $('#searchInput').val().toLowerCase().trim();
                let visibleCount = 0;

                $('.product-item').each(function () {
                    const item = $(this);
                    const title = String(item.data('title'));
                    const author = String(item.data('author'));
                    const price = parseFloat(item.data('price'));
                    const matchesSearch = title.includes(search) || author.includes(search);
                    const matchesPrice = price <= maxPrice;
                    const shouldShow = matchesSearch && matchesPrice;

                    item.toggle(shouldShow);
                    if (shouldShow) {
                        visibleCount++;
                    }
                });

                $('#emptyState').toggleClass('d-none', visibleCount !== 0);
            }

            function sortProducts(sortBy) {
                const container = $('#productContainer');
                const items = $('.product-item').get();

                items.sort(function (a, b) {
                    const first = $(a);
                    const second = $(b);

                    if (sortBy === 'priceAsc') {
                        return parseFloat(first.data('price')) - parseFloat(second.data('price'));
                    }

                    if (sortBy === 'priceDesc') {
                        return parseFloat(second.data('price')) - parseFloat(first.data('price'));
                    }

                    if (sortBy === 'title') {
                        return String(first.data('title')).localeCompare(String(second.data('title')));
                    }

                    if (sortBy === 'author') {
                        return String(first.data('author')).localeCompare(String(second.data('author')));
                    }

                    if (sortBy === 'sold') {
                        return parseInt(second.data('sold')) - parseInt(first.data('sold'));
                    }

                    return 0;
                });

                container.append(items);
            }

            $('#searchInput').on('input', applyFilters);

            $('#sortSelect').on('change', function () {
                sortProducts($(this).val());
                applyFilters();
            });

            $('.price-filter').on('click', function () {
                $('.price-filter').removeClass('active');
                $(this).addClass('active');

                const selectedMax = $(this).data('max');
                maxPrice = selectedMax === '' ? Infinity : parseFloat(selectedMax);
                applyFilters();
            });
        });
    </script>
}
