@model IEnumerable<WebApplication_Project1_Ecommerce.Models.Product>

@{
    var products = Model?.ToList() ?? new List<WebApplication_Project1_Ecommerce.Models.Product>();
    var soldCounts = ViewBag.SoldCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var popularProductIds = ViewBag.PopularProductIds as HashSet<int> ?? new HashSet<int>();
    var featured = products.OrderByDescending(product => soldCounts.ContainsKey(product.Id) ? soldCounts[product.Id] : 0).FirstOrDefault()
        ?? products.FirstOrDefault();
    var fallbackImage = Url.Content("~" + ProductImageHelper.FallbackProductImageUrl);
}

<section class="home-hero">
    <div class="home-hero-content">
        <p class="storefront-kicker">BookHive collections</p>
        <h1>Discover books with a little more electricity.</h1>
        <p>Browse curated picks, compare prices, and jump into the stories readers are choosing right now.</p>
        <div class="home-hero-actions">
            <a href="#productContainer" class="btn btn-warning">Explore Books</a>
            <span>@products.Count book@(products.Count == 1 ? "" : "s") available</span>
        </div>
    </div>

    @if (featured != null)
    {
        var featuredImageUrl = ProductImageHelper.NormalizeProductImageUrl(featured.ImageUrl);

        <div class="featured-book-panel">
            <span class="featured-label">Featured pick</span>
            <img src="@Url.Content("~" + featuredImageUrl)" alt="@featured.Title" onerror="this.onerror=null;this.src='@fallbackImage';" />
            <div>
                <strong>@featured.Title</strong>
                <small>by @featured.Author</small>
            </div>
        </div>
    }
</section>

<section class="shop-filter-bar home-filter-bar">
    <div class="filter-field">
        <label for="searchInput">Search</label>
        <input type="text" id="searchInput" class="form-control" placeholder="Title or author" />
    </div>

    <div class="filter-field">
        <label for="sortSelect">Sort</label>
        <select id="sortSelect" class="form-control">
            <option value="">Featured</option>
            <option value="priceAsc">Price: Low to High</option>
            <option value="priceDesc">Price: High to Low</option>
            <option value="title">Title</option>
            <option value="author">Author</option>
            <option value="sold">Most Sold</option>
        </select>
    </div>

    <div class="filter-actions" aria-label="Price filters">
        <button type="button" class="btn btn-outline-primary price-filter active" data-max="">All</button>
        <button type="button" class="btn btn-outline-primary price-filter" data-max="10">Under $10</button>
        <button type="button" class="btn btn-outline-primary price-filter" data-max="20">Under $20</button>
        <button type="button" class="btn btn-outline-primary price-filter" data-max="50">Under $50</button>
    </div>
</section>

<div id="productContainer" class="row product-grid">
    @foreach (var product in products)
    {
        var sold = soldCounts.ContainsKey(product.Id) ? soldCounts[product.Id] : 0;
        var imageUrl = ProductImageHelper.NormalizeProductImageUrl(product.ImageUrl);

        <div class="col-xl-3 col-lg-4 col-md-6 product-item"
             data-title="@product.Title.ToLower()"
             data-author="@product.Author.ToLower()"
             data-price="@product.Price100"
             data-sold="@sold">
            <article class="product-card home-product-card h-100">
                @if (popularProductIds.Contains(product.Id))
                {
                    <span class="popular-badge"><i class="fa-solid fa-fire"></i> Popular</span>
                }

                <div class="product-cover-wrap">
                    <img src="@Url.Content("~" + imageUrl)" class="product-cover" alt="@product.Title" onerror="this.onerror=null;this.src='@fallbackImage';" />
                </div>

                <div class="product-card-body">
                    <p class="product-title">@product.Title</p>
                    <p class="product-author">by @product.Author</p>
                </div>

                <div class="product-pricing">
                    <span class="product-list-price"><strike>$@product.ListPrice.ToString("0.00")</strike></span>
                    <strong class="product-price">$@product.Price100.ToString("0.00")</strong>
                </div>

                <div class="product-meta-line">
                    <span><i class="fa-solid fa-bag-shopping"></i> @sold sold</span>
                    <span>ISBN @product.ISBN</span>
                </div>

                <a asp-action="Details"
                   asp-route-id="@product.Id"
                   class="btn btn-primary form-control mt-auto">
                    View Details
                </a>
            </article>
        </div>
    }
</div>

<div id="emptyState" class="home-empty-state d-none">
    <h3>No books matched your filters</h3>
    <p>Try a different search term or clear the price filter.</p>
</div>

@section Scripts {
    <script>
        $(function () {
            let maxPrice = Infinity;

            function applyFilters() {
                const search = $('#searchInput').val().toLowerCase().trim();
                let visibleCount = 0;

                $('.product-item').each(function () {
                    const item = $(this);
                    const title = String(item.data('title'));
                    const author = String(item.data('author'));
                    const price = parseFloat(item.data('price'));
                    const matchesSearch = title.includes(search) || author.includes(search);
                    const matchesPrice = price <= maxPrice;
                    const shouldShow = matchesSearch && matchesPrice;

                    item.toggle(shouldShow);
                    if (shouldShow) {
                        visibleCount++;
                    }
                });

                $('#emptyState').toggleClass('d-none', visibleCount !== 0);
            }

            function sortProducts(sortBy) {
                const container = $('#productContainer');
                const items = $('.product-item').get();

                items.sort(function (a, b) {
                    const first = $(a);
                    const second = $(b);

                    if (sortBy === 'priceAsc') {
                        return parseFloat(first.data('price')) - parseFloat(second.data('price'));
                    }

                    if (sortBy === 'priceDesc') {
                        return parseFloat(second.data('price')) - parseFloat(first.data('price'));
                    }

                    if (sortBy === 'title') {
                        return String(first.data('title')).localeCompare(String(second.data('title')));
                    }

                    if (sortBy === 'author') {
                        return String(first.data('author')).localeCompare(String(second.data('author')));
                    }

                    if (sortBy === 'sold') {
                        return parseInt(second.data('sold')) - parseInt(first.data('sold'));
                    }

                    return 0;
                });

                container.append(items);
            }

            $('#searchInput').on('input', applyFilters);

            $('#sortSelect').on('change', function () {
                sortProducts($(this).val());
                applyFilters();
            });

            $('.price-filter').on('click', function () {
                $('.price-filter').removeClass('active');
                $(this).addClass('active');

                const selectedMax = $(this).data('max');
                maxPrice = selectedMax === '' ? Infinity : parseFloat(selectedMax);
                applyFilters();
            });
        });
    </script>
}
