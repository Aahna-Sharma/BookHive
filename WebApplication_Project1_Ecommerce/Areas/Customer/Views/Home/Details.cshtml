@model WebApplication_Project1_Ecommerce.Models.ShoppingCart;

@{
    var imageUrl = ProductImageHelper.NormalizeProductImageUrl(Model.Product.ImageUrl);
    var fallbackImage = Url.Content("~" + ProductImageHelper.FallbackProductImageUrl);
}
<style>
    /* BUTTONS CONTAINER */

    .details-buttons {
        display: flex;
        gap: 16px;
        align-items: center;
    }

        /* COMMON BUTTON STYLE */

        .details-buttons .btn {
            height: 54px;
            padding: 0 26px;
            border-radius: 16px;
            font-size: 15px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.28s ease;
            border: none;
        }

        /* BACK BUTTON */

        .details-buttons .btn-outline-dark {
            background: white;
            border: 1px solid #dbe2ea;
            color: #132238;
            box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        }

            .details-buttons .btn-outline-dark:hover {
                background: #132238;
                color: white;
                border-color: #132238;
                transform: translateY(-2px);
                box-shadow: 0 14px 28px rgba(19,34,56,0.18);
            }

        /* ADD TO CART BUTTON */

        .details-buttons .btn-primary {
            background: linear-gradient( 135deg, #0f766e, #14b8a6 );
            color: white;
            box-shadow: 0 14px 30px rgba(20,184,166,0.24);
            border: 1px solid black;
        }

            .details-buttons .btn-primary:hover {
                transform: translateY(-2px);
                background: linear-gradient( 135deg, #14b8a6, #0f766e);
                box-shadow: 0 18px 36px rgba(6,182,212,0.28);
                border: 1px solid black;
            }

        /* ICONS */

        .details-buttons .btn i {
            font-size: 14px;
        }
</style>

<form method="post" class="details-shell">
    <input type="hidden" asp-for="ProductId" />

    <section class="details-hero">
        <div class="details-cover">
            <img src="@Url.Content("~" + imageUrl)" alt="@Model.Product.Title" onerror="this.onerror=null;this.src='@fallbackImage';" />
        </div>

        <div class="details-content">
            <div class="details-badges">
                <span>@Model.Product.Category?.Name</span>
                <span>@Model.Product.coverType?.Name</span>
            </div>

            <h1>@Model.Product.Title</h1>
            <p class="details-author">by @Model.Product.Author</p>
            <p class="details-isbn">ISBN @Model.Product.ISBN</p>

            <div class="details-price-row">
                <div>
                    <span>List Price</span>
                    <strong class="muted-price">$@Model.Product.ListPrice.ToString("0.00")</strong>
                </div>
                <div>
                    <span>Starts At</span>
                    <strong>$@Model.Product.Price.ToString("0.00")</strong>
                </div>
            </div>

            <div class="details-description">
                @Html.Raw(Model.Product.Description)
            </div>

            <div class="details-price-table">
                <div><span>Qty</span><strong>1-49</strong><strong>50-99</strong><strong>100+</strong></div>
                <div><span>Price</span><strong>$@Model.Product.Price.ToString("0.00")</strong><strong>$@Model.Product.Price50.ToString("0.00")</strong><strong>$@Model.Product.Price100.ToString("0.00")</strong></div>
            </div>

            <div class="details-actions">
                <label>
                    Count
                    <input class="form-control"
                           asp-for="Count"
                           type="number"
                           min="1"
                           value="1"
                           oninput="this.value = this.value < 1 ? 1 : this.value" />
                </label>

                <div class="details-buttons">
                    <a asp-action="Index" class="btn btn-outline-dark">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-cart-shopping"></i>
                        Add to Cart
                    </button>
                </div>
            </div>
        </div>
    </section>
</form>
