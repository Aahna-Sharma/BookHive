@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="privacy-page cinema-panel">
    <p class="eyebrow">BookHive Privacy</p>
    <h1>We keep checkout personal, not invasive.</h1>
    <p class="privacy-lead">
        BookHive uses your information only to run your account, prepare orders,
        send confirmations, and improve your shopping experience.
    </p>

    <div class="privacy-grid">
        <div class="privacy-block">
            <i class="fa-solid fa-user-shield"></i>
            <h2>Account Data</h2>
            <p>Your name, email, phone number, and address are used for sign-in, delivery, invoice emails, SMS, and calls.</p>
        </div>
        <div class="privacy-block">
            <i class="fa-solid fa-credit-card"></i>
            <h2>Payments</h2>
            <p>Payments are processed through Stripe. BookHive stores order status and transaction references, not card numbers.</p>
        </div>
        <div class="privacy-block">
            <i class="fa-solid fa-location-dot"></i>
            <h2>Location</h2>
            <p>Current location is requested only when you choose to autofill your delivery address at checkout.</p>
        </div>
        <div class="privacy-block">
            <i class="fa-solid fa-envelope-open-text"></i>
            <h2>Notifications</h2>
            <p>We may send order invoices, confirmations, payment updates, and delivery-related messages.</p>
        </div>
    </div>
</section>
